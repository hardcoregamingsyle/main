{
  "name": "girl-flapper",
  "version": "2.0.0",
  "description": "A Flappy Bird-style game with a cute girl character. Pure static site — ready for Cloudflare Pages.",
  "private": true,
  "main": "src/game.js",
  "scripts": {
    "start": "npx serve src -l 3000 -s",
    "test": "jest",
    "build": "echo 'Static site — no build step required'",
    "deploy:cf": "npx wrangler pages deploy src --project-name=girl-flapper"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jsdom": "^24.1.0",
    "serve": "^14.2.0",
    "wrangler": "^3.60.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": ["src/game.js"]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}